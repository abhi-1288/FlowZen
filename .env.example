# ============================================================================
# Database
# ============================================================================

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/flowzen

# MongoDB Atlas
ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/flowzen

# ============================================================================
# App
# ============================================================================

NEXT_DEV_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

NEXT_PUBLIC_APP_URL=https://flowzen-azure.vercel.app/
NEXT_PUBLIC_APP_VERSION=

# ============================================================================
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# npx web-push generate-vapid-keys [--json]
# ============================================================================

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@flowzen.local  # your email address for the VAPID subject used from SMTP_USER 
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # its the same as VAPID_PUBLIC_KEY, but you can use a different one if you want to

# ============================================================================
# Setu API
# ============================================================================

SETU_API_KEY=

# ============================================================================
# Gemini API key
# ============================================================================

GEMINI_API_KEY=
PROJECT_NAME=

# ============================================================================
# OAuth Providers
# ============================================================================

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AD
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# GitHub
GITHUB_ID=
GITHUB_SECRET=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ============================================================================
# Email (SMTP)
# ============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FlowZen <no-reply@flowzen.local>"

# ============================================================================
# UploadThing
# ============================================================================

UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
UPLOADTHING_TOKEN=

# ============================================================================
# ImageKit
# ============================================================================

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_ID=

# ============================================================================
# Cloudinary
# ============================================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# Video interview signalling
# ----------------------------------------------------------------------------
# FlowZen video rooms are peer-to-peer WebRTC. Audio and video never touch a
# third-party service — only the SDP offer/answer and ICE candidates are
# exchanged through a realtime broker. Pick ONE provider.
#
# Free-tier concurrent connections (why FlowZen rooms are capped at 50/company/
# month — see lib/interview-quota.ts):
#   Supabase Realtime  200
#   Firebase RTDB Spark 100
# ============================================================================

#SIGNALLING_SERVER_URL=wss://flowzen-signalling-server.onrender.com

# "supabase" (default) or "firebase"
NEXT_PUBLIC_SIGNALING_PROVIDER=supabase

# --- Option A: Supabase Realtime (default) -------------------------------
# Project Settings -> API. Realtime Broadcast + Presence channels are used.
# Nothing to clean up when an interview ends: Broadcast is ephemeral pub/sub and
# stores nothing, and presence is released when the client disconnects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Option B: Firebase Realtime Database -------------------------------
# Only needed when NEXT_PUBLIC_SIGNALING_PROVIDER=firebase.
# Project settings -> General -> Your apps -> SDK setup and configuration.
#
# Unlike Supabase, this provider PERSISTS every offer, answer, ICE candidate and
# bye under flowzen-signals/<roomId>. Submitting feedback (or cancelling an
# interview) deletes that room via the REST API — see lib/signaling/purge.ts —
# and scripts/purge-signaling-rooms.js backfills rooms left by earlier interviews.
#
# Those deletes are unauthenticated, which works because the browser client is
# itself unauthenticated (candidates hold only an invitation token and never
# sign in to Firebase). Your database rules must therefore allow read/write/delete
# on flowzen-signals/**. If they are stricter, purging is skipped and logged
# rather than failing the request.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional: TURN relay (recommended for reliability) ------------------
# STUN alone connects roughly 85-90% of calls. Users behind symmetric NAT or a
# firewall that blocks UDP (~10-15%) cannot connect without a TURN relay.
# Leave blank to run STUN-only; no code changes are needed to add one later.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

